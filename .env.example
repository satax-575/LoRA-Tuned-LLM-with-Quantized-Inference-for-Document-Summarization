# ============================================================
# QLoRA-Tuned Llama 3.1 8B — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Hugging Face ─────────────────────────────────────────────
# Required: Get your token at https://huggingface.co/settings/tokens
# Accept Llama 3.1 license at: https://huggingface.co/meta-llama/Llama-3.1-8B
HF_TOKEN=hf_your_token_here

# ── Model Paths ──────────────────────────────────────────────
BASE_MODEL_NAME=meta-llama/Llama-3.1-8B
LORA_OUTPUT_DIR=./outputs/lora_model
MERGED_MODEL_DIR=./outputs/merged_model
AWQ_MODEL_DIR=./outputs/awq_model

# ── API Security ─────────────────────────────────────────────
# Required for production. Leave empty to disable auth (dev only).
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your_secret_api_key_here

# ── CORS Origins (comma-separated) ───────────────────────────
# Lock down to your actual frontend origins in production
CORS_ORIGINS=http://localhost:3000,http://localhost:7860,http://localhost:8080

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=20

# ── API Server ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
LOG_LEVEL=INFO

# Structured JSON logs (set to true for production log aggregation)
JSON_LOGS=false

# ── Gradio Demo ──────────────────────────────────────────────
GRADIO_PORT=7860
# Must point to the FastAPI backend
API_URL=http://localhost:8000

# ── Experiment Tracking ──────────────────────────────────────
# Get your key at https://wandb.ai/settings
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=qlora-llama31-summarization
WANDB_ENTITY=your_wandb_username

# ── GPU ──────────────────────────────────────────────────────
CUDA_VISIBLE_DEVICES=0
GPU_MEMORY_UTIL=0.85
MAX_MODEL_LEN=2048

# ── Observability ────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ── Misc ─────────────────────────────────────────────────────
PYTHONPATH=.
