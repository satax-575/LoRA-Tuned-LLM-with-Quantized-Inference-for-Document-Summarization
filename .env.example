# ============================================================
# QLoRA-Tuned Llama 3.1 8B — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- Hugging Face ---
# Required: Get your token at https://huggingface.co/settings/tokens
# Must have accepted Meta's Llama 3.1 license at:
# https://huggingface.co/meta-llama/Llama-3.1-8B
HF_TOKEN=hf_your_token_here

# --- Model Paths ---
BASE_MODEL_NAME=meta-llama/Llama-3.1-8B
LORA_OUTPUT_DIR=./outputs/lora_model
MERGED_MODEL_DIR=./outputs/merged_model
AWQ_MODEL_DIR=./outputs/awq_model

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_MAX_CONNECTIONS=20

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_LOG_LEVEL=info

# --- Experiment Tracking ---
# Get your key at https://wandb.ai/settings
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=qlora-llama31-summarization
WANDB_ENTITY=your_wandb_username

# --- GPU ---
CUDA_VISIBLE_DEVICES=0

# --- Misc ---
PYTHONPATH=.
LOG_LEVEL=INFO
