*.parquet
*.arrow
*.jsonl.gz
*.csv.gz
data/raw/
data/processed/

# Experiment tracking
wandb/
runs/
lightning_logs/
mlruns/
.neptune/

# Logs
*.log
logs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
