{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.1.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "QLoRA Llama 3.1 8B — Inference API observability. Latency, cache, GPU, and request metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "📥 Request Rate (req/s)",
      "description": "Rate of summarization requests per second, split by endpoint. A spike here means traffic is rising.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(summarize_requests_total[1m])",
          "legendFormat": "{{endpoint}} ({{status}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },

    {
      "id": 2,
      "title": "⚡ Latency Percentiles (P50 / P95 / P99)",
      "description": "End-to-end request latency. P95 target is ~700ms cold, ~15ms cached. A rising P99 indicates tail latency issues.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(summarize_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P50 (ms)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(summarize_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P95 (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(summarize_latency_seconds_bucket[5m])) * 1000",
          "legendFormat": "P99 (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 8 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom" } }
    },

    {
      "id": 3,
      "title": "💾 Cache Hit Rate",
      "description": "Percentage of requests served from Redis cache. Target: ≥40% hit rate for 40% P95 latency reduction.",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(cache_operations_total{operation=\"hit\"}[5m]) / (rate(cache_operations_total{operation=\"hit\"}[5m]) + rate(cache_operations_total{operation=\"miss\"}[5m])) * 100",
          "legendFormat": "Hit Rate %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 40 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true }
    },

    {
      "id": 4,
      "title": "🔄 Cache Operations",
      "description": "Absolute count of Redis cache hits vs misses over time.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(cache_operations_total{operation=\"hit\"}[1m])",
          "legendFormat": "Hits/s",
          "refId": "A"
        },
        {
          "expr": "rate(cache_operations_total{operation=\"miss\"}[1m])",
          "legendFormat": "Misses/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Hits/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Misses/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } }
    },

    {
      "id": 5,
      "title": "🖥 GPU Memory Usage",
      "description": "VRAM used vs total. Llama 3.1 8B AWQ 4-bit uses ~4.3 GB. Watch for OOM if this approaches total.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "gpu_memory_used_bytes / 1073741824",
          "legendFormat": "Used (GB)",
          "refId": "A"
        },
        {
          "expr": "gpu_memory_total_bytes / 1073741824",
          "legendFormat": "Total (GB)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": { "lineWidth": 2, "fillOpacity": 12 },
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Total (GB)" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "gray", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } }
    },

    {
      "id": 6,
      "title": "🌐 Active Requests",
      "description": "Number of requests currently in-flight (being processed by vLLM). Useful for spotting request pileups.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "active_requests", "legendFormat": "Active", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 16 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" }
    },

    {
      "id": 7,
      "title": "⏱ Model Load Time",
      "description": "Seconds taken to load the AWQ model at startup. Typically 60–120s for Llama 3.1 8B AWQ.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "model_load_time_seconds", "legendFormat": "Load Time", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 120 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" }
    },

    {
      "id": 8,
      "title": "📦 Batch Request Size Distribution",
      "description": "How many documents are typically sent in each /summarize/batch call.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(batch_request_size_bucket[5m]))",
          "legendFormat": "P50 batch size",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(batch_request_size_bucket[5m]))",
          "legendFormat": "P95 batch size",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } }
    },

    {
      "id": 9,
      "title": "✅ Total Requests (all time)",
      "description": "Cumulative request count since the API started.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(summarize_requests_total)", "legendFormat": "Total", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" }
    },

    {
      "id": 10,
      "title": "❌ Error Rate",
      "description": "Rate of 5xx errors. Should be 0 under normal operation.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(summarize_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "Errors/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" }
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["qlora", "llm", "inference", "summarization"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "QLoRA Llama 3.1 8B — Inference API",
  "uid": "qlora-api-v1",
  "version": 1
}
